@import url('https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap');
:root{
  --ink:#13263b;--bg:#ffffff;--soft:#f4f8ff;--surf:#ffffff;--surf2:#f7fafe;
  --mut:#5a6b7d;--faint:#93a3b5;--bd:#e2eaf4;
  --ac:#1766e6;--ac-d:#0f53c4;--ac-s:#e8f1ff;
  --sky:#36a7f0;--sky-s:#e3f4ff;--navy:#0e2742;
  --good:#1a9e5f;--good-s:#e2f3ea;--warn:#9c6b15;--warn-s:#fbf0d6;--over:#c0392b;--over-s:#f7e3df;
}
*{box-sizing:border-box}
html{overflow-x:hidden}
body{margin:0;font-family:"Zen Kaku Gothic New",system-ui,sans-serif;color:var(--ink);background:var(--bg);line-height:1.6;overflow-x:hidden}
a{color:var(--ac)}
/* ---- 上部バー ---- */
.promo{background:linear-gradient(110deg,#0f2f7a,#1766e6 52%,#2f9bf0);color:#fff;position:relative;overflow:hidden}
.promo::after{content:"";position:absolute;top:-60px;right:8%;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.16),transparent 70%);pointer-events:none}
.promo .in{position:relative;max-width:1180px;margin:0 auto;padding:9px 20px;display:flex;align-items:center;justify-content:center;gap:12px;font-size:13px;font-weight:600;flex-wrap:wrap;text-align:center}
.promo .bdg{background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.32);padding:3px 11px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.05em}
.promo a{color:#fff;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px;border-bottom:1px solid rgba(255,255,255,.55);padding-bottom:1px}
.promo a:hover{border-color:#fff}
/* ---- ヘッダー ---- */
.hdr{background:var(--surf);border-bottom:1px solid var(--bd);position:sticky;top:0;z-index:20}
.hdr .in{max-width:1180px;margin:0 auto;padding:13px 20px;display:flex;align-items:center;gap:12px}
.brand{display:flex;align-items:center;gap:9px}
.brand .mk{width:33px;height:33px;border-radius:10px;background:linear-gradient(135deg,#1766e6,#36c6f0);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:16px;box-shadow:0 4px 12px -3px rgba(23,102,230,.55)}
.brand .nm{font-weight:700;font-size:18px;letter-spacing:.01em}
.hdr .sp{flex:1}
.hdr a.pro{font-size:13px;font-weight:700;color:var(--ac);background:transparent;border:1.5px solid var(--ac);padding:8px 16px;border-radius:999px;text-decoration:none;transition:.15s}
.hdr a.pro:hover{background:linear-gradient(120deg,#1766e6,#2f9bf0);color:#fff;border-color:transparent;box-shadow:0 4px 12px -3px rgba(23,102,230,.5)}
/* ---- ヒーロー ---- */
.hero{position:relative;overflow:hidden;background:linear-gradient(180deg,#eaf2ff,#fff 68%);border-bottom:1px solid var(--bd)}
.hero::before{content:"";position:absolute;top:-130px;right:-70px;width:440px;height:440px;border-radius:50%;background:radial-gradient(circle,rgba(54,167,240,.26),transparent 68%);pointer-events:none}
.hero::after{content:"";position:absolute;bottom:-170px;left:-110px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(23,102,230,.14),transparent 70%);pointer-events:none}
.hero .in{position:relative;max-width:1180px;margin:0 auto;padding:56px 20px 48px}
.hero .ey{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:#1b4fb8;letter-spacing:.03em;background:#fff;border:1px solid #d6e4fb;padding:6px 15px;border-radius:999px;margin-bottom:18px;box-shadow:0 3px 12px -3px rgba(23,102,230,.18)}
.hero .ey::before{content:"";width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,#1766e6,#36c6f0);box-shadow:0 0 0 4px rgba(54,167,240,.18)}
.hero h1{font-size:clamp(28px,4.8vw,48px);line-height:1.18;margin:0 0 15px;font-weight:900;letter-spacing:-.02em;background:linear-gradient(100deg,#132742 15%,#1b56c9 75%);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--mut);font-size:16px;margin:0;max-width:62ch}
.hero .tags{display:flex;gap:9px;flex-wrap:wrap;margin-top:20px}
.hero .tag{font-size:12.5px;font-weight:600;color:#274863;background:rgba(255,255,255,.85);border:1px solid #e0e9f6;border-radius:999px;padding:7px 14px 7px 8px;display:inline-flex;align-items:center;gap:8px;box-shadow:0 2px 8px -2px rgba(19,38,59,.08);backdrop-filter:blur(3px)}
.hero .tag svg{width:17px;height:17px;padding:3px;border-radius:50%;background:linear-gradient(135deg,#1766e6,#36c6f0);color:#fff;flex:none}
/* ---- 生成ツール ---- */
.wrap{max-width:1180px;margin:0 auto;padding:30px 20px 46px;display:grid;grid-template-columns:1.04fr .96fr;gap:22px;align-items:start}
.card{background:var(--surf);border:1px solid #e8eef7;border-radius:18px;box-shadow:0 1px 2px rgba(19,38,59,.04),0 18px 40px -24px rgba(19,38,59,.22);min-width:0}
.card.pad{padding:24px}
.card.right{position:sticky;top:84px;overflow:hidden}
.card.right .pvhd{background:linear-gradient(120deg,#1766e6,#2f9bf0 58%,#36c6f0);color:#fff;padding:13px 20px;font-size:12.5px;font-weight:700;letter-spacing:.03em;display:flex;align-items:center;gap:8px}
.card.right .pvbody{padding:20px 22px}
/* セグメント（請求書/見積書） */
.seg{display:flex;flex-wrap:wrap;gap:3px;background:var(--surf2);border:1px solid var(--bd);border-radius:10px;padding:3px;margin-bottom:20px}
.seg button{font-family:inherit;font-size:13px;font-weight:700;border:none;background:none;color:var(--mut);padding:8px 15px;border-radius:7px;cursor:pointer;transition:.12s;flex:1 0 auto}
.seg button.on{background:linear-gradient(120deg,#1766e6,#2f9bf0);color:#fff;box-shadow:0 3px 9px -2px rgba(23,102,230,.45)}
/* フィールド群 */
.fs{margin-bottom:20px}
.fs .lg{font-size:11px;letter-spacing:.07em;color:var(--faint);font-weight:700;text-transform:uppercase;display:block;margin-bottom:10px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
label.fl{display:flex;flex-direction:column;gap:5px;font-size:12px;color:var(--mut);font-weight:600;min-width:0;margin-bottom:10px}
input,select{font-family:inherit;font-size:13.5px;padding:10px 12px;border:1px solid var(--bd);border-radius:9px;background:var(--surf);color:var(--ink);width:100%;min-width:0;transition:.12s}
input:focus,select:focus{outline:none;border-color:var(--ac);box-shadow:0 0 0 3px var(--ac-s)}
input::placeholder{color:#b4c0cd}
details{border:1px solid var(--bd);border-radius:11px;padding:0 15px;margin-bottom:20px;background:var(--surf2)}
details summary{cursor:pointer;font-size:13px;font-weight:700;padding:13px 0;list-style:none;display:flex;align-items:center;gap:8px}
details summary::-webkit-details-marker{display:none}
details summary .chev{margin-left:auto;color:var(--faint);transition:transform .15s}
details[open] summary .chev{transform:rotate(180deg)}
details .body{padding:4px 0 15px}
/* 明細 */
.items{border:1px solid var(--bd);border-radius:11px;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch}
.items .hd,.items .rw{display:grid;grid-template-columns:1fr 44px 40px 82px 54px 28px 24px;gap:6px;align-items:center;padding:9px 11px;font-size:11.5px;min-width:430px}
.items .hd{background:var(--surf2);color:var(--faint);font-weight:700;font-size:10px;border-bottom:1px solid var(--bd)}
.items .rw{border-bottom:1px solid var(--bd)}.items .rw:last-child{border-bottom:none}
.items .rw input,.items .rw select{padding:7px 7px;font-size:12px;min-width:0}
.items .rw .n{text-align:right;font-variant-numeric:tabular-nums}
.items .gen{display:flex;align-items:center;justify-content:center}
.items .del{background:none;border:none;color:var(--faint);cursor:pointer;font-size:16px}
.items .del:hover{color:var(--over)}
.addrow{font-size:12.5px;color:var(--ac);background:var(--ac-s);border:none;border-radius:9px;padding:9px 14px;font-weight:700;cursor:pointer;margin-top:11px}
.addrow:hover{background:#dbe8ff}
/* CTA（右パネル下部） */
.cta{margin-top:18px}
.btn{width:100%;font-family:inherit;font-size:15.5px;font-weight:700;border:none;border-radius:12px;padding:15px;background:linear-gradient(120deg,#1766e6,#2f8cf0 60%,#36b0f0);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 8px 22px -6px rgba(23,102,230,.55);transition:transform .12s,box-shadow .12s,filter .12s}
.btn:hover{filter:brightness(1.04);transform:translateY(-1px);box-shadow:0 12px 26px -6px rgba(23,102,230,.62)}
.btn:active{transform:translateY(0)}
.btn:disabled{opacity:.55;cursor:default;box-shadow:none;transform:none;filter:none}
.remain{font-size:12.5px;color:var(--mut);text-align:center;margin-top:10px}
.remain b{color:var(--ink)}
.limitbox{display:none;background:var(--warn-s);border:1px solid #ecdcae;border-radius:10px;padding:13px 15px;margin-top:11px;font-size:13px;color:var(--ink)}
.limitbox a{font-weight:700}
.msg{font-size:12.5px;padding:9px 12px;border-radius:9px;margin-top:11px;display:none}
.msg.err{display:block;background:var(--over-s);color:var(--over)}
/* プレビュー（書類イメージ） */
.pv{font-size:12px;color:#171a21;background:#fff;border:1px solid #e6ddce;border-radius:6px;padding:26px 26px 24px;box-shadow:0 1px 2px rgba(60,50,30,.05),0 14px 34px -24px rgba(60,50,30,.26);line-height:1.5}
.pv .pv-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px}
.pv .pv-ttl{display:flex;align-items:baseline;gap:9px}
.pv .pv-ttl h2{margin:0;font-size:23px;letter-spacing:.14em;font-weight:900;color:#171a21}
.pv .pv-ttl .en{color:var(--docink,#555);font-size:10px;font-weight:700;letter-spacing:.08em}
.pv .pv-meta{font-size:9px;color:#6b6660;text-align:right;line-height:1.95;font-variant-numeric:tabular-nums;white-space:nowrap}
.pv .pv-rule{height:0;border-top:1.5px solid var(--docink,#111);margin:12px 0 14px}
.pv .pv-party{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}
.pv .pv-to{min-width:0}
.pv .pv-to .nm{font-size:13.5px;font-weight:700;color:#171a21}
.pv .pv-to .ad{font-size:9px;color:#6b6660;margin-top:3px}
.pv .pv-co{text-align:left;font-size:8.5px;color:#6b6660;line-height:1.7;flex:none;min-width:44%}
.pv .pv-co .nm{font-size:11px;font-weight:700;color:#171a21}
.pv .pv-co .rg{color:var(--docink,#111);font-weight:700}
.pv .pv-amt{background:#f2f2f2;border:1px solid #e6ddce;padding:11px 15px;display:flex;justify-content:space-between;align-items:center;margin:15px 0 3px}
.pv .pv-amt .lb{font-size:11px;font-weight:700;color:#171a21}
.pv .pv-amt .vl{font-size:18px;font-weight:900;color:var(--docink,#111);font-variant-numeric:tabular-nums}
.pv .pv-rc{font-size:10px;color:#171a21;margin:10px 0 2px}
.pv .pv-tb{width:100%;border-collapse:collapse;font-size:9px;margin-top:12px}
.pv .pv-tb thead th{background:var(--docbg,#eef2f7);color:#13263b;padding:6px 8px;text-align:right;font-weight:700;font-size:9px;letter-spacing:.02em}
.pv .pv-tb thead th.c-nm{text-align:left}
.pv .pv-tb thead th.c-u{text-align:left}
.pv .pv-tb tbody td{padding:6px 8px;border-bottom:1px solid #efe8da;text-align:right;font-variant-numeric:tabular-nums;color:#171a21}
.pv .pv-tb tbody td:first-child{text-align:left}
.pv .pv-tb tbody td:nth-child(3){text-align:left}
.pv .pv-tb tbody tr:nth-child(even) td{background:#f3f3f3}
.pv .pv-sum{margin-left:auto;width:62%;margin-top:11px;font-size:9.5px}
.pv .pv-sum .sr{display:flex;justify-content:space-between;padding:3px 0;color:#171a21}
.pv .pv-sum .sr.mut{color:#6b6660}
.pv .pv-sum .sr.wh{color:#111}
.pv .pv-sum .tot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--docink,#111);margin-top:5px;padding-top:7px;font-weight:700;font-size:12px;color:#171a21}
.pv .pv-sum .tot .v{color:var(--docink,#111);font-size:13px;font-variant-numeric:tabular-nums}
.pv .pv-box{position:relative;border:1px solid #d9d1c7;background:#fcfbf7;border-radius:3px;padding:12px 14px;margin-top:20px;min-height:46px}
.pv .pv-box .bl{font-size:10px;font-weight:700;color:#171a21;margin-bottom:5px}
.pv .pv-box .mut{font-size:8.5px;color:#6b6660;line-height:1.7}
.pv .pv-box .stamp{position:absolute;top:10px;right:14px;width:58px;height:38px;border:.8px solid #d9d1c7;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:8px;color:#6b6660;text-align:center}
.pv .pv-box .stamp em{font-style:normal;font-size:7.5px}
/* テンプレート別プレビュー */
.pv.classic .pv-tb{border:1px solid #b9b2a6}
.pv.classic .pv-tb thead th{background:#eef2f7;background:var(--docbg,#eef2f7);color:#171a21;border:1px solid #b9b2a6}
.pv.classic .pv-tb tbody td{border:1px solid #d8d1c4}
.pv.classic .pv-tb tbody tr:nth-child(even) td{background:transparent}
.pv.classic .pv-amt{border:1px solid #b9b2a6;background:#f3f1ec}
.pv.minimal .pv-tb thead th{background:transparent;color:#6b6660;border-bottom:1.5px solid #171a21;letter-spacing:.06em}
.pv.minimal .pv-tb tbody td{border-bottom:1px solid #efe8da}
.pv.minimal .pv-tb tbody tr:nth-child(even) td{background:transparent}
.pv.minimal .pv-amt{background:transparent;border:none;border-bottom:2px solid var(--docink,#111);padding:8px 0 6px;margin:12px 0 2px}
.pv.minimal .pv-box{background:transparent;border:none;padding:10px 0 0}
.pv.minimal .pv-ttl{flex-direction:column-reverse;align-items:flex-start;gap:3px}.pv.minimal .pv-ttl h2{border-bottom:3px solid var(--docink,#111);padding-bottom:4px;line-height:1.12}.pv.minimal .pv-ttl .en{letter-spacing:.14em}

/* 下部: 訴求 */
.sell{max-width:1180px;margin:0 auto;padding:6px 20px 54px}
.sell .up{position:relative;overflow:hidden;background:linear-gradient(115deg,#0f2f7a,#1766e6 52%,#2f9bf0);color:#fff;border-radius:20px;padding:32px 34px;display:flex;gap:18px;align-items:center;flex-wrap:wrap;box-shadow:0 20px 44px -18px rgba(23,102,230,.5)}
.sell .up::before{content:"";position:absolute;top:-90px;right:-30px;width:320px;height:320px;border-radius:50%;background:radial-gradient(circle,rgba(255,255,255,.2),transparent 68%);pointer-events:none}
.sell .up::after{content:"";position:absolute;bottom:-120px;left:12%;width:260px;height:260px;border-radius:50%;background:radial-gradient(circle,rgba(54,230,240,.18),transparent 70%);pointer-events:none}
.sell .up>div,.sell .up>a,.sell .up>.sp{position:relative;z-index:1}
.sell .up h3{margin:0 0 7px;font-size:20px;font-weight:900}
.sell .up p{margin:0;font-size:13.5px;opacity:.94;max-width:56ch;line-height:1.7}
.sell .up .sp{flex:1}
.sell .up a{background:#fff;color:#1256cf;font-weight:800;text-decoration:none;padding:13px 24px;border-radius:12px;white-space:nowrap;font-size:14px;box-shadow:0 10px 22px -8px rgba(0,0,0,.35);transition:transform .12s,box-shadow .12s}
.sell .up a:hover{transform:translateY(-1px);box-shadow:0 14px 26px -8px rgba(0,0,0,.4)}
/* FAQ */
.faqwrap{background:linear-gradient(180deg,#eef4ff,#f6faff);border-top:1px solid var(--bd)}
.faq{max-width:900px;margin:0 auto;padding:48px 20px 54px}
.faq h2{font-size:24px;margin:0 0 22px;font-weight:900;text-align:center}
.faq .q{background:var(--surf);border:1px solid #e8eef7;border-radius:14px;padding:18px 20px;margin-bottom:11px;box-shadow:0 6px 18px -12px rgba(19,38,59,.2)}
.faq .q h3{margin:0 0 7px;font-size:14.5px;font-weight:700;display:flex;align-items:center;gap:10px}
.faq .q h3::before{content:"Q";display:inline-flex;align-items:center;justify-content:center;width:23px;height:23px;background:linear-gradient(135deg,#1766e6,#36c6f0);color:#fff;border-radius:8px;font-size:12px;font-weight:900;flex:none;box-shadow:0 3px 8px -2px rgba(23,102,230,.4)}
.faq .q p{margin:0 0 0 31px;font-size:13px;color:var(--mut);line-height:1.75}
/* フッター */
.ft{background:linear-gradient(180deg,#123154,#0b1f38);color:#c6d4e2;border-top:3px solid transparent;border-image:linear-gradient(90deg,#1766e6,#36c6f0) 1}
.ft .in{max-width:1180px;margin:0 auto;padding:40px 20px 28px}
.ft .cols{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:28px;padding-bottom:26px;border-bottom:1px solid rgba(255,255,255,.1)}
.ft .brand .mk{background:#fff;color:var(--navy)}
.ft .brand .nm{color:#fff}
.ft .cols p{font-size:12px;line-height:1.8;margin:12px 0 0;color:#9fb1c4;max-width:34ch}
.ft .col h4{font-size:12px;color:#fff;font-weight:700;margin:0 0 11px;letter-spacing:.03em}
.ft .col a{display:block;font-size:12.5px;color:#c6d4e2;text-decoration:none;margin-bottom:8px}
.ft .col a:hover{color:#fff}
.ft .bot{padding-top:20px;font-size:11.5px;color:#8097ad;line-height:1.75}
@media(max-width:860px){
  .wrap{grid-template-columns:1fr}.card.right{position:static}
  .ft .cols{grid-template-columns:1fr 1fr}
  .sell .up{flex-direction:column;align-items:flex-start}
}
@media(max-width:600px){
  .brand .nm{font-size:15px}
  .hdr a.pro .pro-ex{display:none}
  .hdr a.pro{padding:7px 13px}
  .hdr .in{gap:8px}
}
@media(max-width:520px){.ft .cols{grid-template-columns:1fr}}
/* ===== ブラッシュアップ：差し色・立体感・ヒーロー visual ===== */
:root{--mint:#10b981;--mint-d:#0e9f72;--mint-s:#e7f8f1}
/* ヒーロー：ドットグリッド＋2カラム */
.hero{background:
  radial-gradient(circle at 1px 1px, rgba(23,102,230,.09) 1px, transparent 0) 0 0/22px 22px,
  linear-gradient(180deg,#eaf2ff,#fff 68%)}
.hero .in{display:grid;grid-template-columns:1.08fr .92fr;gap:44px;align-items:center;padding:60px 20px 56px}
.htext{min-width:0}
.hero .tag svg{background:linear-gradient(135deg,#10b981,#36c6f0)}
.hero .ey::before{background:linear-gradient(135deg,#10b981,#36c6f0)}
/* ヒーロー visual（記入済み請求書サンプルが浮遊） */
.hvis{position:relative;height:360px;display:flex;align-items:center;justify-content:center;perspective:1300px}
.hvis .doc{width:340px;background:#fff;border:1px solid #e4ecf8;border-radius:16px;padding:22px 24px;
  box-shadow:0 2px 6px rgba(19,38,59,.05),0 36px 70px -28px rgba(23,80,180,.45);
  transform:rotateY(-13deg) rotateX(5deg) rotateZ(1.5deg);transform-style:preserve-3d;
  animation:floaty 6s ease-in-out infinite}
.hvis .dh{display:flex;align-items:baseline;gap:8px;border-bottom:2px solid var(--ac);padding-bottom:11px}
.hvis .dt{font-size:22px;font-weight:900;letter-spacing:.08em}
.hvis .den{font-size:10px;font-weight:800;color:var(--ac);letter-spacing:.14em}
.hvis .dmeta{font-size:10px;color:#8695a6;text-align:right;margin-top:-30px;line-height:1.7}
.hvis .dto{font-size:13px;font-weight:700;margin:16px 0 14px}
.hvis .damt{background:linear-gradient(120deg,#eaf2ff,#e2f4ff);border:1px solid #cfe1fb;border-radius:11px;
  padding:13px 15px;display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.hvis .damt span{font-size:11.5px;font-weight:700;color:#33506f}
.hvis .damt b{font-size:21px;font-weight:900;color:var(--ac);font-variant-numeric:tabular-nums}
.hvis .drow{display:flex;justify-content:space-between;font-size:11.5px;color:#49586a;padding:6px 2px;border-bottom:1px dashed #e8eef7}
.hvis .drow.sub{color:#8695a6;border-bottom:none}
.hvis .dbar{height:5px;border-radius:999px;margin-top:12px;background:linear-gradient(90deg,#1766e6,#36c6f0)}
.hvis .chip{position:absolute;font-size:12px;font-weight:800;color:#13263b;background:rgba(255,255,255,.92);
  border:1px solid #e0e9f6;border-radius:999px;padding:9px 14px;box-shadow:0 10px 26px -10px rgba(19,38,59,.28);
  backdrop-filter:blur(4px);display:inline-flex;align-items:center;gap:6px}
.hvis .chip-pdf{top:20px;right:4px;animation:floaty 5s ease-in-out infinite .4s}
.hvis .chip-calc{bottom:26px;left:0;color:#0e9f72;animation:floaty 5.6s ease-in-out infinite .9s}
.hvis .chip-calc::before,.hvis .chip-pdf::before{content:"";width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,#10b981,#36c6f0)}
@keyframes floaty{0%,100%{transform:translateY(0) rotateY(-13deg) rotateX(5deg) rotateZ(1.5deg)}50%{transform:translateY(-12px) rotateY(-11deg) rotateX(5deg) rotateZ(1.5deg)}}
@keyframes floaty-chip{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}
.hvis .chip-pdf{animation:floaty-chip 5s ease-in-out infinite .4s}
.hvis .chip-calc{animation:floaty-chip 5.6s ease-in-out infinite .9s}
/* 影を少し柔らかく */
.card{box-shadow:0 1px 2px rgba(19,38,59,.04),0 22px 48px -26px rgba(19,38,59,.26)}
@media(max-width:960px){
  .hero .in{grid-template-columns:1fr;gap:0}
  .hvis{display:none}
}
@media(max-width:600px){
  .hero .in{padding:38px 20px 32px}
  .seg{flex-wrap:nowrap;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
  .seg::-webkit-scrollbar{display:none}
  .seg button{flex:0 0 auto}
}
@media(prefers-reduced-motion:reduce){
  .hvis .doc,.hvis .chip-pdf,.hvis .chip-calc{animation:none}
}

/* hero: stacked layout with live demo showcase */
.hero .in{display:flex;flex-direction:column;gap:30px;align-items:flex-start;padding:52px 20px 48px}
.htext{max-width:none}
.hvis{display:none}
.herodemo{width:100%;max-width:880px;margin:0 auto}
.hd-cap{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;font-weight:700;color:#1b4fb8;margin:0 0 11px 2px}
.hd-cap .dotpulse{width:8px;height:8px;border-radius:50%;background:linear-gradient(135deg,#10b981,#36c6f0);animation:dotpulse 1.8s ease-out infinite}
@keyframes dotpulse{0%{box-shadow:0 0 0 0 rgba(16,185,129,.45)}70%{box-shadow:0 0 0 7px rgba(16,185,129,0)}100%{box-shadow:0 0 0 0 rgba(16,185,129,0)}}
#demoframe{width:100%;height:560px;border:0;display:block;background:transparent;overflow:hidden}
@media(max-width:600px){ .hero .in{padding:34px 20px 30px;gap:22px} #demoframe{height:720px} }
@media(prefers-reduced-motion:reduce){ .hd-cap .dotpulse{animation:none} }

/* ===== 書類ページの解説コンテンツ（SEO本文） ===== */
.art{max-width:820px;margin:0 auto;padding:40px 20px 10px}
.art h2{font-size:22px;font-weight:900;margin:34px 0 12px;padding-left:12px;border-left:4px solid var(--mint,#10b981)}
.art h3{font-size:16.5px;font-weight:700;margin:22px 0 8px}
.art p{font-size:15px;color:#2b3a4b;margin:0 0 12px;line-height:1.85}
.art ul{margin:0 0 14px;padding-left:1.3em}
.art li{font-size:15px;color:#2b3a4b;margin:5px 0}
.art .lead{font-size:16px;color:var(--mut)}
.note{background:var(--sky-s);border:1px solid #cfe6fb;border-radius:12px;padding:14px 18px;font-size:14px;color:#245a86;margin:16px 0}
.steps{display:grid;gap:10px;margin:14px 0}
.step{display:flex;gap:12px;align-items:flex-start;background:var(--surf);border:1px solid var(--bd);border-radius:12px;padding:14px 16px;box-shadow:0 8px 22px -16px rgba(19,38,59,.18)}
.step .n{flex:none;width:26px;height:26px;border-radius:8px;background:linear-gradient(135deg,var(--mint,#10b981),#36c6f0);color:#fff;font-weight:900;font-size:13px;display:flex;align-items:center;justify-content:center}
.step .t{font-size:14.5px;color:#2b3a4b}
/* 書類タイプのナビ（ページ間リンク） */
.kindnav{max-width:1180px;margin:0 auto;padding:18px 20px 16px;display:flex;flex-wrap:wrap;gap:8px}
.kindnav a{font-size:13px;font-weight:700;color:var(--mut);text-decoration:none;padding:8px 15px;border-radius:999px;background:var(--surf2);border:1px solid var(--bd)}
.kindnav a:hover{background:#eef4ff;color:var(--ac)}
.kindnav a.on{background:linear-gradient(120deg,var(--ac),#2f9bf0);color:#fff;border-color:transparent;box-shadow:0 4px 12px -4px rgba(23,102,230,.5)}

.ctaband{max-width:820px;margin:28px auto;padding:0 20px}
.ctaband .in{position:relative;overflow:hidden;background:linear-gradient(115deg,#0f2f7a,#1766e6 52%,#2f9bf0);color:#fff;border-radius:18px;padding:28px 30px;text-align:center;box-shadow:0 20px 44px -20px rgba(23,102,230,.5)}
.ctaband h3{margin:0 0 6px;font-size:19px;font-weight:900}
.ctaband p{margin:0 0 16px;font-size:13.5px;opacity:.94}
.ctaband .btn{display:inline-flex;width:auto;background:#fff;color:#1256cf;padding:14px 26px;border-radius:12px;text-decoration:none;font-weight:800}

/* ===== ブランドロゴ：Free BizDoc + 日本語サブ ===== */
.brand .nm{display:inline-flex;flex-direction:column;justify-content:center;line-height:1.08;gap:1px}
.brand .nm .bn{font-weight:900;font-size:16px;font-style:normal;letter-spacing:.01em;color:inherit}
.brand .nm .sb{font-size:9px;font-weight:700;font-style:normal;color:var(--faint,#93a3b5);letter-spacing:.02em}
.ft .brand .nm .sb{color:#9fb1c4}

.tplseg{display:flex;align-items:center;gap:8px;margin:2px 0 16px;flex-wrap:wrap}
.tplseg .lb{font-size:11px;font-weight:700;color:var(--faint)}
.tplseg button{font-family:inherit;font-size:12px;font-weight:700;padding:7px 12px;border-radius:999px;border:1px solid var(--bd);background:var(--surf);color:var(--mut);cursor:pointer}
.tplseg button.on{background:#111;border-color:#111;color:#fff}
/* クラシック（罫線グリッド）プレビュー */
.pv.classic{border:1px solid #777}
.pv.classic .pv-rule{border-top:1px solid #111}
.pv.classic .pv-amt{background:#f0f0f0;border:1px solid #777}
.pv.classic .pv-tb{border:1px solid #777}
.pv.classic .pv-tb thead th{background:#ececec;color:#111;border:1px solid #999}
.pv.classic .pv-tb tbody td{border:1px solid #c4c4c4}
.pv.classic .pv-tb tbody tr:nth-child(even) td{background:#fff}
.pv.classic .pv-box{border:1px solid #999;background:#fff}

/* PR帯カウントダウン */
@font-face{font-family:'DSEG7';src:url('/fonts/DSEG7Classic-Bold.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap}
.promo{background:linear-gradient(100deg,#0a2a6b 0%,#1766e6 48%,#12bfe6 100%)!important}
.promo-cd{gap:14px!important;font-weight:700}
.promo .pc-txt{font-weight:800;font-size:13.5px;color:#fff}
.promo .pc-txt b{color:#ffe14d}
.promo .pc-timer{display:inline-flex;align-items:center;gap:9px;background:#000;border:1px solid rgba(255,208,0,.55);padding:5px 14px;border-radius:9px;white-space:nowrap;box-shadow:inset 0 0 10px rgba(255,208,0,.12),0 4px 14px -3px rgba(0,0,0,.6)}
.promo .pc-timer .pc-lbl{font-size:11px;font-weight:800;color:#ffd400;letter-spacing:.03em}
.promo .pc-timer .pc-dig{display:inline-flex;align-items:baseline;gap:2px}
.promo .pc-timer .pc-n{font-family:'DSEG7',ui-monospace,monospace;color:#ffd400;font-weight:700;font-size:22px;line-height:1;letter-spacing:.04em;text-shadow:0 0 7px rgba(255,208,0,.7),0 0 2px rgba(255,208,0,.95)}
.promo .pc-timer i{font-style:normal;color:#ffd400;font-size:16px;font-weight:900;margin:0 1px;text-shadow:0 0 6px rgba(255,208,0,.6)}
.promo .pc-timer .u{font-style:normal;color:#ffe680;font-size:11px;font-weight:800;margin:0 3px 0 1px}
.promo .pc-cta{background:#fff;color:#0f53c4!important;font-weight:900;font-size:12.5px;padding:6px 15px;border-radius:999px;border:none!important;box-shadow:0 3px 11px -2px rgba(0,0,0,.4);white-space:nowrap;transition:.15s}
.promo .pc-cta:hover{background:#ffe14d;color:#1a1a1a!important}
@media(max-width:600px){.promo .pc-txt{display:none}.promo-cd{gap:10px!important}.promo .pc-timer .pc-n{font-size:19px}}

/* classic invoice preview = 伝統的な罫線様式（PDFと一致） */
.pv.classic{position:relative}
.pv.classic .pv-top{display:block;text-align:center;margin-bottom:4px}
.pv.classic .pv-ttl{display:inline-flex;justify-content:center}
.pv.classic .pv-ttl h2{border-bottom:2px solid #111;padding-bottom:2px;letter-spacing:.2em}
.pv.classic .pv-rule{display:none}
.pv.classic .pv-meta{position:absolute;right:26px;top:58px;text-align:right}
.pv.classic .pv-party{margin-top:10px;align-items:flex-start}
.pv.classic .pv-to .nm{border-bottom:1px solid #111;display:inline-block;padding-bottom:2px}
.pv.classic .pv-co{border:1px solid #777;padding:8px 44px 8px 10px;position:relative;margin-top:40px}
.pv.classic .pv-co::after{content:'\5370';position:absolute;top:8px;right:8px;width:30px;height:30px;border:1px solid #c4bdb0;display:flex;align-items:center;justify-content:center;font-size:8px;color:#a59c8c}
.pv.classic .pv-tb tbody td{height:14px}
.pv.classic .pv-sum{float:right;width:46%;margin-top:14px;border:1px solid #999;padding:0;font-size:9.5px}
.pv.classic .pv-sum .sr{padding:5px 10px;margin:0;border-bottom:1px solid #d7d2c6}
.pv.classic .pv-sum .tot{padding:6px 10px;margin:0;border-top:1px solid #999;font-weight:700}
.pv.classic .pv-box{float:left;width:48%;margin-top:14px;box-sizing:border-box}
.pv.classic::after{content:"";display:block;clear:both}

.pv.classic .pv-ttl .en{display:none}
